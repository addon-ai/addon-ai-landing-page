# Copia este archivo a `.env.local` y completá los valores.
# `.env.local` está en .gitignore (nunca se commitea).
# IMPORTANTE: Vite resuelve estas variables EN BUILD TIME — reiniciá el dev server después de cambiarlas.

# Formulario de contacto (www.web3forms.com — gratis)
# Crear un form en web3forms.com y pegar acá su access key.
# Solo se usa como FALLBACK si la serverless function no responde.
VITE_WEB3FORMS_ACCESS_KEY=

# ── Camino principal: Resend desde la serverless function ────────────────
# OJO CON ESTAS TRES: son SECRETOS DE SERVIDOR. NO pueden llevar prefijo
# `VITE_`, porque Vite las reemplaza por texto plano en el bundle del cliente
# y publicaría la API key en el navegador de cada visitante. Se configuran en
# Vercel → Settings → Environment Variables, NO en este archivo ni en el repo.
# (La excepción: .env.local funciona solo para dev local; en Vercel van en el
# dashboard porque .env.local está gitignored y nunca se despliega.)
#
# RESEND_API_KEY=re_xxxxxxxxxxxx
# RESEND_FROM_EMAIL=Addon AI <contacto@addonai.biz>
# CONTACT_TO_EMAIL=jiliar.silgado@gmail.com

# Feature flags (default: oculto)
# VITE_SHOW_IMPACTO_ODS=true
# VITE_SHOW_PLAN_PRICES=true
# VITE_SHOW_CASOS_SECTION=true